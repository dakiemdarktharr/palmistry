# Set these in your shell. The app does not automatically load .env files.
PALM_CONFIG=prototype_config.json
PALM_CHECKPOINT=
PALM_CHECKPOINT_SHA256=
# Network mode and frame retention are intentionally unavailable.

# Large archive upload/extraction policy (bytes). The UI uploads in chunks.
PALM_MAX_ARCHIVE_BYTES=8589934592
PALM_MAX_ARCHIVE_EXPANDED_BYTES=34359738368
PALM_MAX_ARCHIVE_MEMBER_BYTES=104857600
PALM_MAX_ARCHIVE_MEMBERS=20000
PALM_ARCHIVE_UPLOAD_CHUNK_BYTES=16777216
PALM_ARCHIVE_UPLOAD_DIR=.web_live_tmp/archive_uploads
PALM_DATASET_DIR=dataset
